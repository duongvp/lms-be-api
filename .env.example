HOCMAI_CHECK_LOGIN_URL="https://hocmai.vn/ladipage/check_login.php"
HOCMAI_CHECK_LOGIN_TOKEN="replace-with-rotated-hocmai-token"

# Google Sheet lưu quan hệ package_id -> course_id.
