PACKAGE_COURSE_SHEET_CACHE_TTL_MS=300000

# API HMO hiện tại: một GET cho mỗi cặp package/course đã loại trùng.
HMO_COURSE_OUTLINE_URL="https://hocmai.vn/api/course/outline"
HMO_COURSE_OUTLINE_TOKEN=""
HMO_COURSE_OUTLINE_CONCURRENCY=5
HMO_COURSE_OUTLINE_TIMEOUT_MS=15000

# Đồng bộ học viên của các lịch được chọn từ API package HOCMAI.
# Token chỉ cấu hình ở backend, không đưa vào NEXT_PUBLIC_*.
HOCMAI_LIVE_USER_API_URL="https://hocmai.vn/api/live-class/package/get-user-register"
HOCMAI_LIVE_USER_API_TOKEN=""
HOCMAI_LIVE_USER_API_LIMIT=100
HOCMAI_LIVE_USER_API_TIMEOUT_MS=30000
HOCMAI_LIVE_USER_SKIP_FINISHTIME=1

# Quét và đồng bộ Lesson ID HMO cho toàn bộ lịch tương lai mỗi sáng.
HMO_LESSON_SYNC_ENABLED=false
HMO_LESSON_SYNC_HOUR=6
HMO_LESSON_SYNC_MINUTE=0
HMO_LESSON_SYNC_TIMEZONE="Asia/Ho_Chi_Minh"

# Đồng bộ tên SCORM từ Google Sheet. Token không được đưa vào source code.
SCORM_NAME_SYNC_SHEET_URL="https://docs.google.com/spreadsheets/d/16jD8NrKsCJIqiz6edfSbsui0CdxQhCLvv8RvChR99M0/edit?usp=sharing"
SCORM_NAME_SYNC_SHEET_CACHE_TTL_MS=120000
SYNC_SCORM_TOKEN=""
SYNC_SCORM_BATCH_SIZE=500
SYNC_SCORM_TIMEOUT_MS=30000

# Xác thực cấp 2 riêng cho phân hệ Đề cương. Giá trị password hash là SHA-256
# dạng hex, tạo bằng: printf %s 'mat-khau-rieng' | sha256sum
LESSONS_SECONDARY_PASSWORD_HASH=""
LESSONS_REAUTH_TOKEN_SECRET="replace-with-an-independent-random-secret"
LESSONS_REAUTH_TTL_MINUTES=15

CALENDAR_IMPORT_MAX_ROWS=1000
CALENDAR_IMPORT_MAX_FILE_SIZE_MB=10
CALENDAR_IMPORT_TRANSACTION_TIMEOUT_MS=60000

# EVG Live Stream. Không commit X-Auth-Key thật vào repository.
EVG_API_BASE_URL="https://live-api.evgcdn.net"
EVG_AUTH_KEY=""
EVG_CALLBACK_EVENT_URL="https://livestream.hocmai.io.vn/api/webhooks/evg"
EVG_ENABLE_RECORD_MP4=1
EVG_S3_STORAGE_ID=74
EVG_PROFILE_ID=7
EVG_REQUEST_TIMEOUT_MS=15000
# Giãn cách request và tự chờ/thử lại khi EVG trả HTTP 429.
EVG_REQUEST_INTERVAL_MS=1500
EVG_RATE_LIMIT_MAX_RETRIES=5
EVG_RATE_LIMIT_RETRY_BASE_MS=5000

# Microsoft Teams Workflows webhook.
# Tạo workflow bằng template "Send webhook alerts to a channel", sau đó cấu
# hình một hoặc nhiều destination. Không commit URL webhook thật vào Git.
TEAMS_NOTIFICATIONS_ENABLED=false
# TEAMS_WEBHOOKS_JSON='[{"name":"operations","url":"https://example.environment.api.powerplatform.com/powerautomate/automations/direct/workflows/..."}]'
TEAMS_WEBHOOKS_JSON='[{"name":"LMS Schedule","url":"https://replace-with-your-teams-workflow-webhook-url"}]'
# Hoặc dùng danh sách URL cách nhau bằng dấu phẩy nếu không cần đặt tên:
# TEAMS_WEBHOOK_URLS="https://...,https://..."
# Chỉ cần khi workflow chọn kiểu xác thực tenant thay vì "Anyone":
TEAMS_WEBHOOK_BEARER_TOKEN=""
TEAMS_NOTIFICATION_POLL_INTERVAL_MS=5000
TEAMS_NOTIFICATION_TIMEOUT_MS=10000
TEAMS_NOTIFICATION_MAX_ATTEMPTS=5
TEAMS_NOTIFICATION_BATCH_SIZE=20

# Ghi lịch học vào Google Sheets bằng service account.
# Chia sẻ quyền Chỉnh sửa sheet cho email này; bật Google Sheets API.
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
CALENDAR_EXPORT_SHEET_URL="https://docs.google.com/spreadsheets/d/1NTrAeL-tEykqqm9R_kQxHVBS-xaGNgarsQ9xP-HM774/edit"
CALENDAR_EXPORT_TOPUNI_SHEET_URL="https://docs.google.com/spreadsheets/d/1DejptU8MU5Zvey_6Z5jtFHlwjGIgKpe3Woqq01IjJrw/edit"

# Export both operational Google Sheets daily at 05:00 Asia/Ho_Chi_Minh
CALENDAR_EXPORT_CRON_ENABLED=true

# Quét user giáo viên/trợ giảng cho cửa sổ lịch 7 ngày lúc 03:00 giờ Việt Nam.
CALENDAR_TEACHING_USER_CRON_ENABLED=true
