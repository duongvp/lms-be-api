generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model calendar {
  id                Int                   @id @default(autoincrement()) @db.UnsignedInt
  session_id        BigInt?
  code              String                @db.VarChar(30)
  learn_number      Int
  subject           String?               @db.VarChar(100)
  start_time        DateTime              @db.Timestamp(0)
  end_time          DateTime              @db.Timestamp(0)
  teacher           String?               @db.VarChar(150)
  assistant_teacher String?               @db.VarChar(500)
  lesson_name       String?               @db.VarChar(400)
  lesson_document   String?               @db.LongText
  evg_banner        String?               @db.VarChar(500)
  evg_stream        String?               @db.VarChar(500)
  lesson_link       String?               @db.VarChar(500)
  lesson_count      Int?
  lesson_baitap     String?               @db.VarChar(500)
  lesson_tomtat     String?               @db.VarChar(500)
  lesson_phuongphap String?               @db.VarChar(500)
  lesson_luuy       String?               @db.VarChar(500)
  lesson_ketqua     String?               @db.VarChar(500)
  channel_name      String?               @db.VarChar(500)
  lesson_status     Int?                  @default(0) @db.TinyInt
  lesson_noti       String?               @db.VarChar(500)
  key               String?               @db.VarChar(100)
  system_type       calendar_system_type? @default(topclass)
  created_at        DateTime?             @default(now()) @db.Timestamp(0)
  updated_at        DateTime?             @default(now()) @db.Timestamp(0)

  @@unique([key], map: "uq_calendar_key")
  @@index([session_id], map: "idx_calendar_session_id")
  @@index([code, learn_number], map: "idx_calendar_code_learn")
  @@index([code, learn_number, start_time, end_time], map: "idx_calendar_code_time")
  @@index([system_type], map: "idx_calendar_system")
  @@index([start_time, end_time], map: "idx_calendar_time")
}

model calendar_change_logs {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  operation_id      String   @unique(map: "uq_calendar_change_operation") @db.Char(36)
  action            String   @db.VarChar(30)
  calendar_id       Int?     @db.UnsignedInt
  old_key           String?  @db.VarChar(100)
  new_key           String?  @db.VarChar(100)
  code              String   @db.VarChar(30)
  learn_number      Int
  reason            String   @db.VarChar(500)
  actor_user_id     Int?     @db.UnsignedInt
  actor_username    String   @db.VarChar(100)
  before_data       Json
  after_data        Json
  affected_sessions Json
  created_at        DateTime @default(now()) @db.DateTime(3)

  @@index([calendar_id, created_at], map: "idx_calendar_change_calendar")
  @@index([old_key], map: "idx_calendar_change_old_key")
  @@index([new_key], map: "idx_calendar_change_new_key")
  @@index([actor_user_id, created_at], map: "idx_calendar_change_actor")
  @@index([created_at], map: "idx_calendar_change_created")
}

model teams_notification_outbox {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  event_key       String    @db.VarChar(191)
  destination     String    @db.VarChar(100)
  event_type      String    @db.VarChar(30)
  calendar_id     Int?      @db.UnsignedInt
  payload         Json
  status          Int       @default(0) @db.TinyInt
  attempts        Int       @default(0)
  next_attempt_at DateTime  @default(now()) @db.DateTime(3)
  locked_at       DateTime? @db.DateTime(3)
  sent_at         DateTime? @db.DateTime(3)
  last_error      String?   @db.Text
  created_at      DateTime  @default(now()) @db.DateTime(3)
  updated_at      DateTime  @default(now()) @updatedAt @db.DateTime(3)

  @@unique([event_key, destination], map: "uq_teams_notification_event_destination")
  @@index([status, next_attempt_at], map: "idx_teams_notification_dispatch")
  @@index([calendar_id, created_at], map: "idx_teams_notification_calendar")
}

